{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI SSH",
  "version": "0.1.0",
  "identifier": "com.aissh.menubar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "AI SSH Sessions", "width": 1040, "height": 720, "visible": false }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["app"], "macOS": { "minimumSystemVersion": "12.0" } }
}
