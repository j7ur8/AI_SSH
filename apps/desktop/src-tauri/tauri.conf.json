{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI SSH",
  "version": "0.2.0",
  "identifier": "com.aissh.menubar",
  "build": {
    "beforeDevCommand": "npm run prepare:helpers && npm run dev",
    "beforeBuildCommand": "npm run prepare:helpers && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "AI SSH Sessions", "width": 1040, "height": 720, "visible": false }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": ["binaries"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "icon": ["icons/128x128.png", "icons/32x32.png", "icons/64x64.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/j7ur8/AI_SSH/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEQTkxREY4MzI0MTg0RDkKUldUWmhFRXkrQjJwN1ZuZzhPbGZQSUNhSjY5TmVMcm5Qcm9GaENHWFVEdzVMeXZIT0lTZ2llcG0K"
    }
  }
}
