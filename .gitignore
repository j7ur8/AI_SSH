/target
/apps/desktop/node_modules
/apps/desktop/dist
# Staged by apps/desktop/scripts/prepare-helpers.mjs before every build.
/apps/desktop/src-tauri/binaries/

# Produced by the release workflow's packaging step.
/apps/desktop/AI-SSH-*
/apps/desktop/latest.json
.DS_Store
*.log

# Written by tauri-build on every build; the editor resolves the $schema
# pointers in capabilities/ against it once a build has run.
/apps/desktop/src-tauri/gen/schemas/

# Never commit signing or key material. The updater key pair deliberately lives
# outside the repository, and this keeps a stray copy from being committed.
*.key
*.pem
*.p12
ai-ssh-updater.key*

# Local agent harness state.
.zcode/
